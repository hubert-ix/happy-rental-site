# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

GMAIL_USER=you.rentals@gmail.com
# 16-character app password from https://myaccount.google.com/apppasswords (spaces are fine)
GMAIL_APP_PASSWORD=

# --- Listing extraction (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Geocoding (OpenStreetMap Nominatim; their policy requires a contact email) ---
NOMINATIM_EMAIL=you@example.com

# --- Notifications ---
# Email address that receives "new match" digests (sent through the same Gmail account)
NOTIFY_EMAIL=you@example.com
# Optional: push to your phone with the free ntfy app (https://ntfy.sh). Pick an unguessable topic.
NTFY_TOPIC=

# --- Security ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set in Vercel
CRON_SECRET=change-me-long-random-string
# Basic-auth password for the dashboard (username can be anything)
DASHBOARD_PASSWORD=change-me

# --- Tuning ---
MAX_EMAILS_PER_RUN=15
